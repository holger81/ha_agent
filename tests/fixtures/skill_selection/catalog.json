{
  "description": "Skill catalog used by the skill-selection corpus tests. Mirrors the skills the agent actually learns in a household (one reading/status workflow, several device-control workflows, and soft-domain workflows).",
  "skills": [
    {
      "slug": "look-up-sensor-or-entity-status",
      "title": "Look up sensor or entity status",
      "description": "Parameterized status lookup for a reading in a room (temperature, humidity, air quality, energy).",
      "triggers": [
        "what is the temperature in {{query}}",
        "status of {{query}}",
        "look up {{query}} sensor",
        "how warm is it in {{query}}"
      ],
      "body": "Search for the sensor, then read its state.",
      "tool_steps": [
        {"toolName": "home_assistant__ha_search", "arguments": {"query": "{{query}}", "domain_filter": "sensor"}},
        {"toolName": "home_assistant__ha_get_state", "arguments": {"entity_id": "{{entity_id}}"}}
      ],
      "route_scope": "chat",
      "group": "reading"
    },
    {
      "slug": "control-lights",
      "title": "Turn lights on or off",
      "description": "Switch or dim lights in a room.",
      "triggers": [
        "turn on the {{query}} lights",
        "turn off the {{query}} light",
        "dim the {{query}} lights"
      ],
      "body": "Find the light entity, then call the light service.",
      "tool_steps": [
        {"toolName": "home_assistant__ha_search", "arguments": {"query": "{{query}}", "domain_filter": "light"}},
        {"toolName": "home_assistant__ha_call_service", "arguments": {"entity_id": "{{entity_id}}", "service": "{{service}}"}}
      ],
      "route_scope": "action",
      "group": "control"
    },
    {
