      "body": "Find the lock entity, then call the lock service.",
      "tool_steps": [
        {"toolName": "home_assistant__ha_search", "arguments": {"query": "{{query}}", "domain_filter": "lock"}},
        {"toolName": "home_assistant__ha_call_service", "arguments": {"entity_id": "{{entity_id}}", "service": "{{service}}"}}
      ],
      "route_scope": "action",
      "group": "control"
    },
    {
      "slug": "set-thermostat",
