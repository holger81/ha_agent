      "tool_steps": [
        {"toolName": "home_assistant__ha_search", "arguments": {"query": "{{query}}", "domain_filter": "climate"}},
        {"toolName": "home_assistant__ha_call_service", "arguments": {"entity_id": "{{entity_id}}", "service": "set_temperature"}}
      ],
      "route_scope": "action",
      "group": "control"
    },
